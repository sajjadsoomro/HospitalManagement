<Window x:Class="HospitalManagement.App.Views.PatientInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:System="clr-namespace:System;assembly=System.Runtime"
        xmlns:DataModels="clr-namespace:HospitalManagement.Data.DataModels;assembly=HospitalManagement.Data"
        mc:Ignorable="d"
        Title="Edit Patient" Height="800" Width="550"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues"
                            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="DataModels:Gender"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Patient Details"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   HorizontalAlignment="Center" 
                   Margin="0,10" />

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <!-- First Name -->
                <TextBox materialDesign:HintAssist.Hint="First Name"
                         Text="{Binding EditablePatient.FirstName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="50"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Last Name -->
                <TextBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Last Name"
                         Text="{Binding EditablePatient.LastName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="50"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Date of Birth -->
                <DatePicker Margin="0,20,0,0" materialDesign:HintAssist.Hint="Date of Birth"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding EditablePatient.DateOfBirth, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Gender -->
                <ComboBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Gender"
                          ItemsSource="{Binding Source={StaticResource dataFromEnum}}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectedItem="{Binding EditablePatient.Gender, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>

                <!-- Phone Number -->
                <TextBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Phone Number"
                         Text="{Binding EditablePatient.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Assigned Doctor -->
                <ComboBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Assigned Doctor"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          SelectedValue="{Binding EditablePatient.Doctor, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="DoctorName"
                          ItemsSource="{Binding Doctors}" />

                <!-- Email -->
                <TextBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Email (Optional)"
                         Text="{Binding EditablePatient.Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <!-- Address -->
                <TextBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Address (Optional)"
                         Text="{Binding EditablePatient.Address, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         AcceptsReturn="True"
                         Height="80" />

                <!-- Medical History -->
                <TextBox Margin="0,20,0,0" materialDesign:HintAssist.Hint="Medical History (Optional)"
                         Text="{Binding EditablePatient.MedicalHistory, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         AcceptsReturn="True"
                         Height="80" />
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Margin="0,0,10,0" />
            <Button Content="Save" 
                    Command="{Binding SaveCommand}" 
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
