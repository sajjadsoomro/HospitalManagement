# Ignore bin and obj folders
bin/
obj/

# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.
.vs/
*.user
*.suo
*.log
*.tlog
*.vspscc
*.vssscc
*.cache
*.pdb
*.ilk
*.idb

# Ignore NuGet packages
*.nupkg
packages/

# Ignore build output
*.dll
*.exe
*.app
*.ipa
*.so
*.dylib
*.lib

# Ignore Publish files
publish/
